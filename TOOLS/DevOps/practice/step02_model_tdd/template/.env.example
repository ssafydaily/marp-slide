# 이 파일을 복사해 .env 로 사용하세요:  cp .env.example .env
# (.env 는 Git 에 커밋하지 않습니다)

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=django-insecure-dev-only-key

POSTGRES_DB=todo_db
POSTGRES_USER=todo_user
POSTGRES_PASSWORD=todo_password
POSTGRES_HOST=localhost
# 로컬에 이미 PostgreSQL 이 5432 포트를 쓰고 있다면 5433 등으로 변경
POSTGRES_PORT=5432
