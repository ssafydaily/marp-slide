# 서버의 ~/todo-api/.env 로 복사해서 값을 채우세요 (Git 에 올리지 않음)
#   nano ~/todo-api/.env

# --- Django ---
# 생성: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# localhost 는 헬스체크용으로 반드시 포함, EC2 퍼블릭 IP(또는 도메인) 추가
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,YOUR_EC2_PUBLIC_IP
DJANGO_CSRF_TRUSTED_ORIGINS=http://YOUR_EC2_PUBLIC_IP

# --- PostgreSQL ---
POSTGRES_DB=todo_db
POSTGRES_USER=todo_user
POSTGRES_PASSWORD=change-me-strong-password

# --- 배포 이미지 ---
# IMAGE_TAG / PREVIOUS_IMAGE_TAG 는 deploy.sh 가 배포할 때 자동으로 추가·갱신합니다
IMAGE=ghcr.io/YOUR_GITHUB_ID/todo-api
