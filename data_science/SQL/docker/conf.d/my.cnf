# MySQL 서버 설정 (이미지 빌드 시 컨테이너의 /etc/mysql/conf.d/my.cnf 로 복사된다)

[mysqld]
# 문자셋과 정렬 규칙: 한글과 이모지까지 저장하려면 utf8mb4
character-set-server = utf8mb4
collation-server     = utf8mb4_0900_ai_ci

# 표준 SQL에 가깝게 동작하도록 엄격 모드와 ONLY_FULL_GROUP_BY 를 켠다
sql_mode = ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# 서버 시간대 (NOW(), CURRENT_TIMESTAMP 의 기준)
default-time-zone = '+09:00'

# 트랜잭션 격리 수준 (InnoDB 기본값을 명시)
transaction-isolation = REPEATABLE-READ

# 실습용 계정이 프로시저/함수/트리거를 만들 수 있도록 바이너리 로그를 끈다
skip-log-bin

# 느린 쿼리 로그: 1초 이상 걸린 쿼리를 기록
slow_query_log  = ON
long_query_time = 1

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
